# ---- Deployment ----
# What this deployment is: development (default; the container image defaults to production) |
# test | demo | staging | production. staging/production (and any unknown value) refuse to start
# with unsafe configuration (see docs/DEPLOYMENT.md §1).
DEPLOY_ENV=
# Whether app instances migrate when they start. Default: off in staging/production (the
# `npm run db:migrate` deploy step does it; production refuses true), on elsewhere.
MIGRATE_ON_START=
# Database connections per process (default 10).
DATABASE_POOL_MAX=
# Proxies you control that append to X-Forwarded-For (default 1), or an edge header with the
# client IP (e.g. cf-connecting-ip behind Cloudflare). Used for login and flood limits.
TRUSTED_PROXY_HOPS=
CLIENT_IP_HEADER=
# Storage: local (now) | s3 (Cloudflare R2 / AWS S3, from PR 4.2).
STORAGE_DRIVER=
# Local storage root (default ./.data/files).
STORAGE_DIR=
# Only for a single-instance staging/production pilot with a persistent, backed-up volume.
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=
# Workers (`npm run worker`): jobs, ai, or both (default); poll interval and shutdown drain time.
WORKER_QUEUES=
WORKER_INTERVAL_MS=
WORKER_DRAIN_MS=
# Reported by /api/health/live and /ready.
APP_VERSION=
# Transactional email: only "log" (never sends) until a provider is chosen.
EMAIL_PROVIDER=
EMAIL_FROM=

# ---- Core ----
APP_URL=http://localhost:3000
# 32+ random bytes, base64. Encrypts OAuth tokens at rest and signs public asset links.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=

# ---- Database ----
# Leave empty to use embedded Postgres (PGlite + pgvector) stored in ./.data/pg.
# Set to a Supabase/Postgres URL (with the pgvector extension) for production.
DATABASE_URL=

# ---- AI (reasoning, strategy, copy, vision) ----
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
ANTHROPIC_MODEL=
# Set AI_PROVIDER=mock ONLY for local UI work and tests. Mock output is labeled in the UI.
# In production builds mock is ignored unless AI_ALLOW_MOCK_IN_PRODUCTION=true (demos/E2E only).
AI_PROVIDER=
AI_ALLOW_MOCK_IN_PRODUCTION=
# Marketing Strategist: set to "off" to disable web research (findings become labelled hypotheses).
STRATEGIST_WEB_SEARCH=
# Optional overrides for the AI cost estimates shown in the app (USD).
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
AI_PRICE_WEB_SEARCH_PER_1K=

# ---- Embeddings for brand memory (optional) ----
# Without a key, a local feature-hashing embedder is used (lower recall, no network).
VOYAGE_API_KEY=

# ---- Image generation ----
# openai (gpt-image-1) | none. With "none", creatives use approved brand photos or type-led layouts.
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
# Optional: image model, and the price per image for cost reporting (unset = counted, unpriced).
OPENAI_IMAGE_MODEL=
IMAGE_PRICE_USD=
# "off" skips the Claude vision review in the brand consistency check.
CREATIVE_BRAND_CHECK=

# ---- Social platform apps (OAuth) ----
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- Billing (Stripe) ----
# Plans change only from verified webhooks. Webhook endpoint: {APP_URL}/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.created/updated/deleted/paused/resumed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring monthly Price ids for the paid plans
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=

# ---- Android app (Trusted Web Activity) ----
# Served at /.well-known/assetlinks.json so the app opens without a browser bar. See docs/ANDROID.md.
ANDROID_PACKAGE_NAME=
# Comma-separated SHA-256 fingerprints (AA:BB:...): upload key + Play App Signing key
ANDROID_CERT_SHA256=

# ---- Jobs ----
# Protects /api/cron/tick for external schedulers (Vercel Cron, GitHub Actions, etc.)
CRON_SECRET=
