# ---- Core ----
APP_URL=http://localhost:3000
# 32+ random bytes, base64. Encrypts OAuth tokens at rest and signs public asset links.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=

# ---- Database ----
# Leave empty to use embedded Postgres (PGlite + pgvector) stored in ./.data/pg.
# Set to a Supabase/Postgres URL (with the pgvector extension) for production.
DATABASE_URL=

# ---- AI (reasoning, strategy, copy, vision) ----
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
ANTHROPIC_MODEL=
# Set AI_PROVIDER=mock ONLY for local UI work and tests. Mock output is labeled in the UI.
# In production builds mock is ignored unless AI_ALLOW_MOCK_IN_PRODUCTION=true (demos/E2E only).
AI_PROVIDER=
AI_ALLOW_MOCK_IN_PRODUCTION=
# Marketing Strategist: set to "off" to disable web research (findings become labelled hypotheses).
STRATEGIST_WEB_SEARCH=
# Optional overrides for the AI cost estimates shown in the app (USD).
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
AI_PRICE_WEB_SEARCH_PER_1K=

# ---- Embeddings for brand memory (optional) ----
# Without a key, a local feature-hashing embedder is used (lower recall, no network).
VOYAGE_API_KEY=

# ---- Image generation ----
# openai (gpt-image-1) | none. With "none", creatives render as typographic brand layouts only.
IMAGE_PROVIDER=openai
OPENAI_API_KEY=

# ---- Social platform apps (OAuth) ----
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- Billing (Stripe) ----
# Plans change only from verified webhooks. Webhook endpoint: {APP_URL}/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.created/updated/deleted/paused/resumed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring monthly Price ids for the paid plans
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=

# ---- Android app (Trusted Web Activity) ----
# Served at /.well-known/assetlinks.json so the app opens without a browser bar. See docs/ANDROID.md.
ANDROID_PACKAGE_NAME=
# Comma-separated SHA-256 fingerprints (AA:BB:...): upload key + Play App Signing key
ANDROID_CERT_SHA256=

# ---- Jobs ----
# Protects /api/cron/tick for external schedulers (Vercel Cron, GitHub Actions, etc.)
CRON_SECRET=
