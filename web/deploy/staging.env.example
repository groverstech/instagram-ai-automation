# BrandPilot staging: the complete configuration for the private-beta staging environment.
#
# Copy into the hosting platform's secret store (never into the repository). Values marked
# OWNER come from accounts only the owner can create; everything else is decided here.
# The web, worker and migrate roles all validate this at start-up and refuse to run on any error
# (DEPLOYMENT.md §1, §6). Rehearse with `npm run e2e:staging` locally first, then on staging.

# ---- Environment -----------------------------------------------------------------------------
DEPLOY_ENV=staging
APP_URL=https://staging.YOUR-DOMAIN            # OWNER: the staging domain (https only)
APP_SECRET=                                    # generate: openssl rand -base64 48  (keep it; rotation: DEPLOYMENT §7)
CRON_SECRET=                                   # generate: openssl rand -hex 24
APP_VERSION=                                   # set by the deploy pipeline to the image tag
TRUSTED_PROXY_HOPS=1                           # number of proxies in front of the app (load balancer = 1)

# ---- Database --------------------------------------------------------------------------------
# The app connects as an ordinary role (no superuser, no BYPASSRLS). Migrations run as the owner
# role in the separate migrate step, which is also when deploy/app-role-grants.sql is applied.
DATABASE_URL=                                  # OWNER: postgres://brandpilot_app:…@host/brandpilot (managed Postgres with PITR)
MIGRATE_ON_START=false
RLS_PILOT=on

# ---- Background work -------------------------------------------------------------------------
RUN_JOBS_IN_PROCESS=false                      # a separate worker runs (image role: worker)
WORKER_QUEUES=jobs,ai

# ---- Storage (single-instance pilot until R2, PR 4.2) -----------------------------------------
STORAGE_DRIVER=local
STORAGE_DIR=/app/.data/files                   # a persistent, backed-up volume
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true         # explicit single-instance opt-in

# ---- Access ----------------------------------------------------------------------------------
SIGNUP_MODE=invite_only                        # beta list: npm run beta:invite -- add <email> --by <you>
EMAIL_VERIFICATION=required
MFA_REQUIRED_FOR_ADMINS=true

# ---- Email (decision D-7) --------------------------------------------------------------------
EMAIL_PROVIDER=postmark                        # or resend
EMAIL_API_KEY=                                 # OWNER: provider API key (server token)
EMAIL_FROM=BrandPilot <no-reply@YOUR-DOMAIN>   # OWNER: a verified sender domain (SPF/DKIM)

# ---- AI (staging spends real money only inside these limits) ----------------------------------
AI_PROVIDER=anthropic
BRANDPILOT_ANTHROPIC_API_KEY=                  # OWNER: a dedicated key with a provider-side spend limit
IMAGE_PROVIDER=none                            # openai once OPENAI_API_KEY is set and the image budget approved
OPENAI_API_KEY=
AI_SPEND_CAP_REQUIRED=true
AI_SPEND_CAP_USD=25                            # hard cap for the whole staging deployment
AI_SPEND_CAP_SINCE=2026-12-01T00:00:00Z        # when the staging budget starts (UTC)
AI_TRIPWIRE_USD=5                              # stops a runaway loop: well above normal spend per window
AI_TRIPWIRE_WINDOW_MIN=60
CREDITS_MODE=shadow                            # enforcement stays OFF until separately authorised (D-17)
VOYAGE_API_KEY=                                # leave empty: the local embedder is used (Voyage isn't metered)

# ---- Publishing ------------------------------------------------------------------------------
AUTONOMOUS_PUBLISHING=off                      # stays OFF until separately authorised
SOCIAL_SANDBOX=                                # never in staging or production (refused)
META_APP_ID=                                   # OWNER: Meta app (test users until app review)
META_APP_SECRET=                               # OWNER
LEGAL_ENTITY_NAME=                             # OWNER: from counsel, for the legal pages
LEGAL_CONTACT_EMAIL=                           # OWNER

# ---- Billing (optional for the beta: plans can be assigned by the operator) --------------------
STRIPE_SECRET_KEY=                             # OWNER: test-mode key for staging
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=

# ---- Monitoring (decision D-8) ----------------------------------------------------------------
SENTRY_DSN=                                    # OWNER: Sentry project DSN; unexpected errors are reported with their reference

# ---- Retention -------------------------------------------------------------------------------
AUDIT_RETENTION_DAYS=400
EXPORT_FILE_BUDGET_MB=100
