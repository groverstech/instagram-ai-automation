{
  "name": "brandpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "worker": "node --conditions=react-server --import tsx src/server/jobs/worker.ts",
    "db:seed": "tsx --conditions=react-server src/server/db/seed.ts",
    "db:migrate": "node --conditions=react-server --import tsx src/server/db/migrate-cli.ts",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "ai:billing": "node --conditions=react-server --import tsx src/server/ai/billing-cli.ts",
    "ai:check-anthropic": "node --conditions=react-server --import tsx src/server/ai/anthropic-check-cli.ts",
    "reviewer:setup": "node --conditions=react-server --import tsx src/server/reviewer-cli.ts",
    "credits": "node --conditions=react-server --import tsx src/server/credits-cli.ts",
    "beta:invite": "node --conditions=react-server --import tsx src/server/beta-invites-cli.ts",
    "ai:controls": "node --conditions=react-server --import tsx src/server/ai/controls-cli.ts",
    "secrets:rotate": "node --conditions=react-server --import tsx src/server/secrets-rotate-cli.ts",
    "users": "node --conditions=react-server --import tsx src/server/users-cli.ts",
    "publishing:stop": "node --conditions=react-server --import tsx src/server/emergency-stop-cli.ts",
    "e2e:lifecycle": "bash e2e/lifecycle.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-pgvector": "^0.0.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next": "^15.5.29",
    "postgres": "^4.1.0",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
